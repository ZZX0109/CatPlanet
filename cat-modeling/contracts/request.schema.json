{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestVersion": {
      "type": "number",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^job-[a-z0-9][a-z0-9-]{0,62}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "model-fit",
        "local-edit",
        "groom-adjust",
        "model-validate",
        "groom-validate"
      ]
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "modelRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "templateId": {
      "type": "string",
      "const": "cat-foundation-v1"
    },
    "topologyVersion": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "modelLicense": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "verified"
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "localReviewAllowed": {
          "type": "boolean",
          "const": true
        },
        "trainingAllowed": {
          "type": "boolean"
        },
        "publicDistributionAllowed": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "identifier",
        "localReviewAllowed",
        "trainingAllowed",
        "publicDistributionAllowed"
      ],
      "additionalProperties": false
    },
    "references": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9._-]+)+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "user-provided",
                  "repository-original",
                  "licensed-third-party"
                ]
              },
              "creator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "source",
              "creator",
              "evidence"
            ],
            "additionalProperties": false
          },
          "license": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "verified"
              },
              "identifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "localReviewAllowed": {
                "type": "boolean",
                "const": true
              },
              "trainingAllowed": {
                "type": "boolean"
              },
              "publicDistributionAllowed": {
                "type": "boolean"
              }
            },
            "required": [
              "status",
              "identifier",
              "localReviewAllowed",
              "trainingAllowed",
              "publicDistributionAllowed"
            ],
            "additionalProperties": false
          },
          "ownerConsent": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "path",
          "sha256",
          "mediaType",
          "provenance",
          "license",
          "ownerConsent"
        ],
        "additionalProperties": false
      }
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "const": "meter"
        },
        "handedness": {
          "type": "string",
          "const": "right"
        },
        "up": {
          "type": "string",
          "const": "+Y"
        },
        "forward": {
          "type": "string",
          "const": "+Z"
        },
        "origin": {
          "type": "string",
          "const": "floor-center"
        }
      },
      "required": [
        "units",
        "handedness",
        "up",
        "forward",
        "origin"
      ],
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10
        },
        "width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10
        },
        "length": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10
        }
      },
      "required": [
        "height",
        "width",
        "length"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "maxVertices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2500000
        },
        "maxTriangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000
        },
        "maxJoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "maxTextureBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        }
      },
      "required": [
        "maxVertices",
        "maxTriangles",
        "maxJoints",
        "maxTextureBytes"
      ],
      "additionalProperties": false
    },
    "executionBudget": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maxMemoryMiB": {
          "type": "integer",
          "minimum": 128,
          "maximum": 65536
        },
        "device": {
          "type": "string",
          "enum": [
            "cpu",
            "gpu",
            "auto"
          ]
        },
        "maxGpuMemoryMiB": {
          "type": "integer",
          "minimum": 0,
          "maximum": 49152
        }
      },
      "required": [
        "timeoutSeconds",
        "maxMemoryMiB",
        "device",
        "maxGpuMemoryMiB"
      ],
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "properties": {
        "designSchemaVersion": {
          "type": "number",
          "const": 5
        },
        "templateId": {
          "type": "string",
          "const": "cat-foundation-v1"
        },
        "coatType": {
          "type": "string",
          "enum": [
            "long",
            "short",
            "hairless"
          ]
        },
        "coatMode": {
          "type": "string",
          "enum": [
            "source",
            "groom"
          ]
        },
        "shape": {
          "type": "object",
          "properties": {
            "headRound": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headWedge": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headWidth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headDepth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "cheeks": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "jaw": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "muzzle": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "muzzleWidth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "noseBridge": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "eyeSize": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "eyeSpacing": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "eyeTilt": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "earSize": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "earTilt": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headFurDensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headFurLength": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "ruffFurDensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "ruffFurLength": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "bodyFurDensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "bodyFurLength": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "headRound",
            "headWedge",
            "headWidth",
            "headDepth",
            "cheeks",
            "jaw",
            "muzzle",
            "muzzleWidth",
            "noseBridge",
            "eyeSize",
            "eyeSpacing",
            "eyeTilt",
            "earSize",
            "earTilt",
            "headFurDensity",
            "headFurLength",
            "ruffFurDensity",
            "ruffFurLength",
            "bodyFurDensity",
            "bodyFurLength"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "designSchemaVersion",
        "templateId",
        "coatType",
        "coatMode",
        "shape"
      ],
      "additionalProperties": false
    },
    "groom": {
      "type": "object",
      "properties": {
        "groomSchemaVersion": {
          "type": "number",
          "const": 1
        },
        "topologyVersion": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "bodySurface": {
          "type": "object",
          "properties": {
            "node": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
            }
          },
          "required": [
            "node"
          ],
          "additionalProperties": false
        },
        "representation": {
          "type": "string",
          "enum": [
            "none",
            "guides"
          ]
        },
        "guides": {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rootBinding": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
                  },
                  "triangleIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "barycentric": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "node",
                  "triangleIndex",
                  "barycentric"
                ],
                "additionalProperties": false
              },
              "points": {
                "minItems": 2,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -10,
                      "maximum": 10
                    },
                    {
                      "type": "number",
                      "minimum": -10,
                      "maximum": 10
                    },
                    {
                      "type": "number",
                      "minimum": -10,
                      "maximum": 10
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "radiusMeters": {
                "type": "number",
                "minimum": 0.000001,
                "maximum": 0.01
              }
            },
            "required": [
              "rootBinding",
              "points",
              "radiusMeters"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "groomSchemaVersion",
        "topologyVersion",
        "bodySurface",
        "representation",
        "guides"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "landmarks": {
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "nose",
                  "eyeL",
                  "eyeR",
                  "earL",
                  "earR",
                  "pawFL",
                  "pawFR",
                  "pawBL",
                  "pawBR"
                ]
              },
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  },
                  {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  },
                  {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "source": {
                "type": "string",
                "enum": [
                  "measured",
                  "user-confirmed",
                  "inferred"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "name",
              "position",
              "source",
              "confidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "landmarks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestVersion",
    "jobId",
    "operation",
    "modelId",
    "modelRevision",
    "templateId",
    "topologyVersion",
    "modelLicense",
    "references",
    "coordinates",
    "dimensions",
    "budgets",
    "executionBudget",
    "appearance",
    "groom",
    "features"
  ],
  "additionalProperties": false,
  "$id": "urn:miaoxing:cat-modeling:contracts:request:1"
}

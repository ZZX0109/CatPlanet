{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "type": "number",
      "const": 1
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "modelRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "topologyVersion": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "const": "meter"
        },
        "handedness": {
          "type": "string",
          "const": "right"
        },
        "up": {
          "type": "string",
          "const": "+Y"
        },
        "forward": {
          "type": "string",
          "const": "+Z"
        },
        "origin": {
          "type": "string",
          "const": "floor-center"
        }
      },
      "required": [
        "units",
        "handedness",
        "up",
        "forward",
        "origin"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "string",
      "const": "A-morphology"
    },
    "state": {
      "type": "string",
      "enum": [
        "unavailable",
        "validated-output"
      ]
    },
    "appearance": {
      "type": "object",
      "properties": {
        "designSchemaVersion": {
          "type": "number",
          "const": 5
        },
        "templateId": {
          "type": "string",
          "const": "cat-foundation-v1"
        },
        "coatType": {
          "type": "string",
          "enum": [
            "long",
            "short",
            "hairless"
          ]
        },
        "coatMode": {
          "type": "string",
          "enum": [
            "source",
            "groom"
          ]
        },
        "shape": {
          "type": "object",
          "properties": {
            "headRound": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headWedge": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headWidth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headDepth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "cheeks": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "jaw": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "muzzle": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "muzzleWidth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "noseBridge": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "eyeSize": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "eyeSpacing": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "eyeTilt": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "earSize": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "earTilt": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headFurDensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "headFurLength": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "ruffFurDensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "ruffFurLength": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "bodyFurDensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "bodyFurLength": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "headRound",
            "headWedge",
            "headWidth",
            "headDepth",
            "cheeks",
            "jaw",
            "muzzle",
            "muzzleWidth",
            "noseBridge",
            "eyeSize",
            "eyeSpacing",
            "eyeTilt",
            "earSize",
            "earTilt",
            "headFurDensity",
            "headFurLength",
            "ruffFurDensity",
            "ruffFurLength",
            "bodyFurDensity",
            "bodyFurLength"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "designSchemaVersion",
        "templateId",
        "coatType",
        "coatMode",
        "shape"
      ],
      "additionalProperties": false
    },
    "model": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9._-]+)+$"
                },
                {
                  "type": "string",
                  "enum": [
                    "appearance.json",
                    "model.glb",
                    "groom.json",
                    "validation.json",
                    "preview.png",
                    "features.json"
                  ]
                }
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "features": {
      "type": "object",
      "properties": {
        "landmarks": {
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "nose",
                  "eyeL",
                  "eyeR",
                  "earL",
                  "earR",
                  "pawFL",
                  "pawFR",
                  "pawBL",
                  "pawBR"
                ]
              },
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  },
                  {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  },
                  {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "source": {
                "type": "string",
                "enum": [
                  "measured",
                  "user-confirmed",
                  "inferred"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "name",
              "position",
              "source",
              "confidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "landmarks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "interfaceVersion",
    "requestSha256",
    "modelId",
    "modelRevision",
    "topologyVersion",
    "coordinates",
    "module",
    "state",
    "appearance",
    "model",
    "features"
  ],
  "additionalProperties": false,
  "$id": "urn:miaoxing:cat-modeling:contracts:module-a-morphology:1"
}

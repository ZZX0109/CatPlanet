{$APP_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 6MB
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
  }
  reverse_proxy app:3000 {
    header_up X-Real-IP {remote_host}
  }
}
